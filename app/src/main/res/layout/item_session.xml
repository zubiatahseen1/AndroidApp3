<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the history list. Inflated once per visible row and then recycled. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textRowSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_green"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="482 steps" />

        <TextView
            android:id="@+id/textRowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp"
            tools:text="0.37 km · 19 kcal · 5m 02s" />

        <TextView
            android:id="@+id/textRowTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:text="Sat 4:15 PM" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
