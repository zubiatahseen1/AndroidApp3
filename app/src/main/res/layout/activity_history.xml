<?xml version="1.0" encoding="utf-8"?>
<!-- Second screen: list of walks saved during this app session. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".HistoryActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="@string/title_history"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textTotals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:textStyle="bold"
        tools:text="3 walks · 1,204 steps total" />

    <!-- Shown only when the repository is empty; the RecyclerView hides in its place. -->
    <TextView
        android:id="@+id/textEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="48dp"
        android:text="@string/history_empty"
        android:textColor="@color/text_muted"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSessions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        tools:itemCount="3"
        tools:listitem="@layout/item_session" />
</LinearLayout>
