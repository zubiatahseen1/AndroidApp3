<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        ACTIVITY_RECOGNITION is a DANGEROUS permission from Android 10 (API 29) onward.
        Declaring it here is only half the job: MainActivity must also ask the user
        for it at run time. This is the sensor equivalent of ACCESS_FINE_LOCATION
        in the LocationFinder tutorial.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!--
        required="false" means "this app is nicer with a hardware step counter, but
        it still runs without one." Google Play would otherwise hide the app from
        phones (and emulators) that have no pedometer chip. Our accelerometer
        fallback is what makes running without one possible.
    -->
    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidApp3">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Second screen: the list of walks saved during this app session. -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>
